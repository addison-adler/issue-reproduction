{
    "rootDir": "src",
    "stagingDir": "out/bsc",
    "sourceMap": true,

    "retainStagingDir": true,
    "createPackage": false,

    "autoImportComponentScript": true,
    "pruneEmptyCodeFiles": false,

    "files": [

        { "src": "**/*", "dest": "source" },
        { "src": "**/(component)?(s)/**", "dest": "components" },
        
        "manifest",
        "!**/*.md"
    ]
}
